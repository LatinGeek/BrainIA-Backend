{
  "name": "brainia-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "schema:verify": "tsx src/scripts/migrate.ts --verify",
    "backfill:semantics": "tsx src/scripts/backfill-semantics.ts",
    "backfill:semantic-subjects": "tsx src/scripts/backfill-missing-semantic-subjects.ts",
    "backfill:semantic-orphans": "tsx src/scripts/backfill-orphan-semantics.ts",
    "backfill:financial-merchants": "tsx src/scripts/backfill-financial-merchant-links.ts",
    "backfill:event-evidence-parents": "tsx src/scripts/backfill-event-evidence-parents.ts",
    "backfill:event-taxonomy": "tsx src/scripts/backfill-event-taxonomy.ts",
    "backfill:ownership": "tsx src/scripts/backfill-ownership.ts",
    "backfill:embeddings": "tsx src/scripts/backfill-embeddings.ts",
    "reprocess:semantic-pending": "tsx src/scripts/reprocess-pending-semantics.ts",
    "reprocess:generations": "tsx src/scripts/reprocess-generations.ts",
    "normalize:providers": "tsx src/scripts/normalize-provider-identities.ts",
    "normalize:hierarchy": "tsx src/scripts/normalize-hierarchy-relations.ts",
    "reconcile:semantic-governance": "tsx src/scripts/reconcile-semantic-governance.ts",
    "audit:semantic-graph": "tsx src/scripts/audit-semantic-graph.ts",
    "audit:semantic-entities": "tsx src/scripts/audit-rooted-semantics.ts",
    "probe:deepseek": "tsx src/scripts/probe-deepseek-semantic.ts",
    "inspect:semantic-proposals": "tsx src/scripts/inspect-semantic-proposals.ts",
    "cleanup:test-data": "tsx src/scripts/cleanup-test-data.ts",
    "smoke:remote": "tsx src/scripts/remote-smoke.ts",
    "worker:once": "tsx src/scripts/process-jobs.ts",
    "verify:backup": "tsx src/scripts/verify-backup.ts",
    "test": "node --test --import tsx tests/api-contracts.test.ts tests/capture.test.ts tests/domain.test.ts tests/e2e.test.ts tests/financial-consolidation.test.ts tests/pending-financial-transactions.test.ts tests/generated-content.test.ts tests/inspect.test.ts tests/interpretation-harness.test.ts tests/notification-safety.test.ts tests/knowledge-platform.test.ts tests/p0-foundation.test.ts tests/p1-knowledge.test.ts tests/semantic-governance.test.ts tests/decision-policy.test.ts tests/evidence-policy-eval.test.ts tests/evidence-approval.test.ts tests/interpretation-generations.test.ts",
    "harness:interpretation": "node --test --import tsx tests/interpretation-harness.test.ts",
    "harness:generated-content": "node --test --import tsx tests/generated-content.test.ts",
    "harness:semantics": "tsx src/scripts/semantic-harness.ts",
    "harness:semantics:live": "tsx src/scripts/semantic-harness.ts --live",
    "test:isolated": "node tests/run-isolated.mjs",
    "test:v2": "node --import tsx tests/v2-harness/run.mjs",
    "eval:v2": "node --import tsx tests/v2-harness/run.mjs --offline",
    "eval:interpretation": "node --import tsx tests/v2-harness/compare.mjs",
    "test:eval:interpretation": "node --test tests/v2-harness/comparison.test.mjs tests/v2-harness/harness.test.mjs",
    "contracts:verify": "node contracts/brain-ai/2.0.0/verify.mjs",
    "test:intelligence": "node --import ./tests/pglite-setup.mjs --import tsx --test tests/intelligence.test.ts",
    "evaluate:jev": "tsx src/scripts/evaluate-jev.ts",
    "evaluate:laya": "tsx src/scripts/evaluate-laya.ts",
    "validate:live:intelligence": "tsx src/scripts/validate-live-intelligence.ts",
    "laya:start": "powershell -ExecutionPolicy Bypass -File scripts/start-laya.ps1",
    "dev:laya": "powershell -ExecutionPolicy Bypass -File scripts/start-brainia-with-laya.ps1"
  },
  "dependencies": {
    "fastify": "^5.3.3",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
