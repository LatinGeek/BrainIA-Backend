{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "serverless.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "serverless.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/process-jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/v1/cron/daily-insights",
      "schedule": "0 8 * * *"
    }
  ]
}
