# Local development defaults.
# In Vercel, Neon injects DATABASE_URL and DATABASE_URL_UNPOOLED automatically when the integration is linked.
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brainia
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/brainia

# Optional auth. Leave empty until you want to protect the API.
BRAINIA_API_KEY=
# Format: clientId:key,clientId2:key2
BRAINIA_CLIENT_KEYS=

# Optional model-assisted features.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_INPUT_USD_PER_MILLION_TOKENS=0
DEEPSEEK_OUTPUT_USD_PER_MILLION_TOKENS=0

# Processing and operations. `inline` preserves synchronous API compatibility;
# `queued` returns immediately after durable capture.
BRAINIA_PROCESSING_MODE=inline
BRAINIA_WORKER_BATCH_SIZE=10
BRAINIA_OPERATIONS_TOKEN=

# Vercel sends `Authorization: Bearer <CRON_SECRET>` to the daily route.
CRON_SECRET=

# Optional OpenAI-compatible embedding endpoint. Without it BrainIA uses its
# deterministic local semantic embedding model.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=brainia-semantic-hash
EMBEDDING_VERSION=embedding-v1

# Optional restored database used by `npm run verify:backup`.
BACKUP_DATABASE_URL=
INSIGHT_DEDUPE_DAYS=30

# Next-version capabilities: migrate before enabling. Roll out independently.
BRAINIA_INTELLIGENCE_ENABLED=false
BRAINIA_LEARNING_ENABLED=false
BRAINIA_JEV_MODE=off
# Defaults to TypeSafe. Point this at a local Laya server for self-hosting.
JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Comma-separated classes that passed held-out precision evaluation. Empty fails closed.
JEV_VALIDATED_KINDS=
DEEPSEEK_KNOWLEDGE_MODEL=deepseek-flash
